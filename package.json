{
  "name": "catalog-search",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "crawl": "node crawler/run.mjs",
    "review": "node crawler/review.mjs",
    "test": "node --test config/*.test.mjs crawler/*.test.mjs icp/model.test.mjs",
    "build:backend": "node icp/scripts/build-backend.mjs",
    "test:icp": "node --test icp/backend.test.mjs",
    "build:icp": "PUBLIC_BASE_PATH=/ vite build --outDir ../.icp-build/frontend --manifest"
  },
  "dependencies": {
    "@icp-sdk/auth": "^10.0.2",
    "@icp-sdk/canisters": "4.0.0",
    "@icp-sdk/core": "6.1.1"
  },
  "devDependencies": {
    "@dfinity/pic": "0.25.0",
    "@dfinity/response-verification": "4.0.1",
    "vite": "^7.0.0"
  }
}
